#
# Karthika - environment
#
# Copy to .env.local and fill in what you need. NOTHING here is required to run
# the site: with an empty file the storefront runs end to end on the seed
# catalogue in src/lib/data/catalog.ts, as a guest, with cash on delivery.
#
# Each block switches on one capability, independently of the others.
#

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph tags and the sitemap. Set it in
# production; localhost is assumed otherwise.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Supabase  (optional)
#
# Set BOTH of these and the app switches from the seed catalogue to the
# database. Set neither and it stays on seed data. Run supabase/schema.sql,
# then policies.sql, then seed.sql against the project first.
#
# The service-role key bypasses Row Level Security. It is read only by
# server-side code (guarded by `server-only`) and must never be given the
# NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Firebase Authentication  (optional)
#
# Without these, sign-in is disabled and the account pages say so. Checkout
# still works as a guest.
#
# The NEXT_PUBLIC_ values are the web app config. They are not secrets: they
# identify the project, and Firebase security rules are what protect it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Admin service account, from Firebase console > Project settings >
# Service accounts > Generate new private key. These ARE secrets. The private
# key is multi-line: wrap it in quotes and keep the \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# Admin access  (optional)
#
# Comma-separated email addresses allowed into /admin. They must also be able
# to sign in through Firebase.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=


# ---------------------------------------------------------------------------
# Razorpay  (optional)
#
# Without these, online payment is unavailable and checkout offers cash on
# delivery only. Start with the rzp_test_ keys.
#
# The webhook secret is set when you create the webhook in the Razorpay
# dashboard, pointing at /api/razorpay/webhook and subscribed to
# payment.captured, payment.failed and refund.processed.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
